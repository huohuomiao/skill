{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache_metadata.schema.json",
  "title": "Validated content-addressed stage cache metadata",
  "type": "object",
  "required": [
    "schema_version",
    "stage_config_version",
    "stage",
    "fingerprint",
    "created_at",
    "validation_levels",
    "input_sha256",
    "dependency_fingerprints",
    "source_snapshot",
    "run_context",
    "mode",
    "budget_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "stage_config_version": {"const": 2},
    "stage": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_fingerprints": {"type": "object"},
    "source_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "run_context": {"type": ["object", "null"]},
    "mode": {"type": ["string", "null"]},
    "budget_sha256": {"type": ["string", "null"]},
    "validation_levels": {
      "type": "array",
      "items": {"type": "string", "enum": ["l1", "l2", "l3"]},
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
