{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_context.schema.json",
  "title": "MLU Triton run context",
  "type": "object",
  "required": ["schema_version", "execution_backend", "hardware_key", "toolchain_key"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_backend": {"type": "string", "enum": ["local", "worker"]},
    "hardware_key": {"type": "string", "minLength": 1},
    "toolchain_key": {"type": "string", "minLength": 1},
    "device_info": {"type": "object"},
    "toolchain_info": {"type": "object"}
  },
  "additionalProperties": false
}
