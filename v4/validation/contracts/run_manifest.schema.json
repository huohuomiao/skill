{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_manifest.schema.json",
  "title": "Resumable MLU Triton run manifest",
  "type": "object",
  "required": ["schema_version", "stage_config_version", "run_id", "mode", "output_dir", "cache_dir", "request", "stages", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "stage_config_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["correctness", "balanced", "max-performance"]},
    "output_dir": {"type": "string", "minLength": 1},
    "cache_dir": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "run_context": {"type": ["object", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "stages": {"type": "object"},
    "events": {"type": "array"}
  },
  "additionalProperties": false
}
