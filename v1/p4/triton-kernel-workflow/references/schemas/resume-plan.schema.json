{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-plan.schema.json",
  "title": "Cache reuse and rerun plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "optimization_mode", "generated_at", "output_dir", "cache_root", "resume_from", "stages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["full", "code-generation", "code-validation", "performance-tuning"]},
    "optimization_mode": {"enum": ["correctness", "balanced", "max-performance"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "output_dir": {"type": "string", "minLength": 1},
    "cache_root": {"type": "string", "minLength": 1},
    "resume_from": {"type": ["string", "null"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "action", "reason", "fingerprint", "fingerprint_path", "cache_record"],
        "properties": {
          "stage": {"enum": ["environment", "requirement-extraction", "code-generation", "code-validation", "performance-tuning", "finalization"]},
          "action": {"enum": ["reuse", "rerun", "skip"]},
          "reason": {"type": "string", "minLength": 1},
          "fingerprint": {"type": ["string", "null"]},
          "fingerprint_path": {"type": ["string", "null"]},
          "cache_record": {"type": ["string", "null"]}
        }
      }
    }
  }
}
