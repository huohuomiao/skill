{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-cache-record.schema.json",
  "title": "Immutable stage cache record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "fingerprint", "created_at", "fingerprint_path", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"enum": ["environment", "requirement-extraction", "code-generation", "code-validation", "performance-tuning", "finalization"]},
    "fingerprint": {"type": "string", "minLength": 64},
    "created_at": {"type": "string", "format": "date-time"},
    "fingerprint_path": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_path", "cache_path", "sha256", "size_bytes"],
        "properties": {
          "target_path": {"type": "string", "minLength": 1},
          "cache_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
