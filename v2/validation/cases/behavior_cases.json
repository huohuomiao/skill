{
  "version": 1,
  "cases": [
    {
      "id": "requirement_normal_path",
      "description": "自然语言需求必须进入完整的代码生成设计路径。",
      "input_kind": "requirement",
      "requires_mlu": false,
      "expected_route": {
        "must_run": ["EnvConfig", "Extractor", "ExtractBaseInfo", "TraceBlockMapping", "AxisFusion", "GenerateSpec", "GenerateCode", "GenTestCode", "CodeReview"],
        "must_skip": [],
        "terminal": "KernelGen/triton_code_fix.py"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-code-gen/SKILL.md",
          "contains": ["`is_triton: false`", "执行 Stage 1-4 后进入 Stage 5"]
        }
      ]
    },
    {
      "id": "triton_input_fast_path",
      "description": "已有 Triton 代码必须跳过设计阶段并直接进入测试生成。",
      "input_kind": "triton_code",
      "requires_mlu": false,
      "expected_route": {
        "must_run": ["EnvConfig", "Extractor", "GenTestCode", "CodeReview"],
        "must_skip": ["ExtractBaseInfo", "TraceBlockMapping", "AxisFusion", "GenerateSpec"],
        "terminal": "KernelGen/triton_code_fix.py"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-code-gen/SKILL.md",
          "contains": ["跳过 Stage 1-4", "直接使用 `{输出存储路径}/Extractor/original_code.py`"]
        }
      ]
    },
    {
      "id": "code_review_original_pass",
      "description": "原代码通过时不得进入静态或动态修复。",
      "input_kind": "executable_triton",
      "requires_mlu": true,
      "expected_route": {
        "must_run": ["CodeReviewInitialRun"],
        "must_skip": ["StaticReviewer", "DynamicFixer"],
        "terminal": "xxx_fix.py"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-code-review/SKILL.md",
          "contains": ["原代码通过 —— 直接产出并结束", "将原文件**原样拷贝**"]
        }
      ]
    },
    {
      "id": "code_review_infrastructure_failure",
      "description": "基础设施错误不得触发 Kernel 改写。",
      "input_kind": "infrastructure_failure",
      "requires_mlu": true,
      "expected_route": {
        "must_run": ["CodeReviewInitialRun"],
        "must_skip": ["StaticReviewer", "DynamicFixer", "KernelMutation"],
        "terminal": "report_infrastructure_error"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-code-review/SKILL.md",
          "contains": ["基础设施错误", "不要修改 kernel 代码"]
        }
      ]
    },
    {
      "id": "code_review_dynamic_cap",
      "description": "动态修复必须具有确定的停止条件。",
      "input_kind": "kernel_failure",
      "requires_mlu": true,
      "expected_route": {
        "must_run": ["StaticReviewer", "DynamicFixer"],
        "must_skip": [],
        "terminal": "pass_or_max_5_iterations"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-code-review/SKILL.md",
          "contains": ["最大 5 次迭代", "同类错误连续 2 次"]
        }
      ]
    },
    {
      "id": "advanced_optimization_output_priority",
      "description": "深度优化产物存在时必须作为最终候选，OOB 只能作为回退。",
      "input_kind": "optimized_triton",
      "requires_mlu": true,
      "expected_route": {
        "must_run": ["OOBOptimization", "AdvancedOptimization", "FinalSelection"],
        "must_skip": [],
        "terminal": "Optimizer/triton_optimized.py"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-optimize/SKILL.md",
          "contains": ["步骤 3 已执行且 `{output_dir}/Optimizer/triton_advanced_optimized.py` 存在", "步骤 3 未执行或深度优化产物缺失"],
          "not_contains": ["若步骤 3 有执行，使用 `{output_dir}/Optimizer/triton_oob_optimized.py`"]
        }
      ]
    },
    {
      "id": "local_failure_worker_fallback",
      "description": "本地环境检查失败时必须复用当前 Job 的 Worker。",
      "input_kind": "local_environment_failure",
      "requires_mlu": true,
      "expected_route": {
        "must_run": ["LocalEnvCheck", "WorkerEnvCheck"],
        "must_skip": ["CreateNewJob"],
        "terminal": "execution_backend_worker_or_stop"
      },
      "source_assertions": [
        {
          "file": "mlu-triton-main/SKILL.md",
          "contains": ["如果任意一个脚本在本地执行环境失败", "禁止为了编译、测试、精度或性能验证再新建一个 Job"]
        }
      ]
    }
  ]
}
